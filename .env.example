# Copy this file to ".env" and fill in real values.
# ".env" MUST NOT be committed (see .gitignore).

# --- LLM provider ---
# Which provider to use. Example: "openai", "groq", "google", "openrouter".
LLM_PROVIDER=

# API key for the chosen LLM provider.
# DO NOT paste real keys into source control.
LLM_API_KEY=

# Model name to call (example: "gpt-4o-mini", "llama-3.1-70b-versatile").
LLM_MODEL=

# Optional: timeout in seconds for LLM calls.
LLM_TIMEOUT_SECONDS=30

# --- Server ---
# Host/port for uvicorn. Safe defaults for local dev.
APP_HOST=127.0.0.1
APP_PORT=8000
